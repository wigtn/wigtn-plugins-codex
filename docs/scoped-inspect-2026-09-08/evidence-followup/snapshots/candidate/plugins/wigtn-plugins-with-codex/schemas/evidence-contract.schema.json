{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wigtn.com/schemas/evidence-contract/1.0",
  "title": "WIGTN Evidence Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "source_artifacts",
    "requirements",
    "checks",
    "release_authority",
    "external_actions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "enum": [
        "product-spec",
        "acceptance",
        "delivery",
        "release"
      ]
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "status",
          "code_evidence",
          "check_ids",
          "gaps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*(?:-[A-Z0-9_]+)+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "implemented-not-executed",
              "partially-verified",
              "not-satisfied",
              "not-verifiable",
              "not-applicable"
            ]
          },
          "code_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line_start", "line_end"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "symbol": {
                  "type": "string"
                }
              }
            }
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CHK-[0-9]{2,}$"
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "status",
          "exit_code",
          "test_names"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CHK-[0-9]{2,}$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "test_names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "release_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_request",
        "commit",
        "push",
        "pull_request",
        "deploy"
      ],
      "properties": {
        "source_request": {
          "type": "string"
        },
        "commit": {
          "type": "boolean"
        },
        "push": {
          "type": "boolean"
        },
        "pull_request": {
          "type": "boolean"
        },
        "deploy": {
          "type": "boolean"
        }
      }
    },
    "external_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "status",
          "evidence"
        ],
        "properties": {
          "action": {
            "enum": [
              "commit",
              "push",
              "pull_request",
              "deploy"
            ]
          },
          "status": {
            "enum": [
              "performed",
              "not-performed",
              "blocked",
              "failed"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
